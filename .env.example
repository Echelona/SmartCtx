# SmartCtx — ตัวแปรแวดล้อม
# คัดลอกไฟล์นี้เป็น .env แล้วตั้งค่าจริงก่อนใช้งาน (.env ห้าม commit เข้า git)

PORT=4000
# SmartPharmacy ใช้พอร์ต 3000 อยู่แล้วบนเครื่อง production เดียวกัน — ตั้ง SmartCtx ไว้ที่ 4000
# แทนค่า default ทั่วไปของ Node/Express (3000) โดยตั้งใจ เพื่อไม่ให้ชนกัน

# ใช้เข้ารหัส session cookie — ตั้งเป็นค่าสุ่มยาวๆ ก่อนใช้งานจริง (ไม่ใช่รหัสผ่านของใคร)
SESSION_SECRET=change-me-to-a-long-random-string-before-production

# ---------- 1.1 งานจัดซื้อ (login แยกเฉพาะ ตามสเปก) ----------
PROCUREMENT_USERNAME=inv
PROCUREMENT_PASSWORD=inv123

# ---------- 1.2 งานคลังเคมีบำบัด, โมดูล 2 (เตรียมยาเฉพาะราย), โมดูล 3 (Pharm Care Unit) ----------
# ใช้บัญชีเดียวกันตามที่ระบุไว้ — ถ้าต้องการแยก login ต่อโมดูลภายหลัง เพิ่มตัวแปรแยกแล้วแก้ server.js ตรง createModuleAuth ของแต่ละโมดูล
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin5889

# ---------- รหัสผ่านสำหรับล้างข้อมูลทดสอบ (Danger Zone ในหน้างานคลังเคมีบำบัด) ----------
# แยกจาก login ปกติโดยเจตนา — ใช้เฉพาะช่วงทดสอบระบบเท่านั้น ควรลบ/เปลี่ยนก่อนใช้งานจริง
SUDO_CLEAR_PASSWORD=sudo5889
